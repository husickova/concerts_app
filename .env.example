# --- Základ ---
# SQLite pro vývoj; v produkci lze přepnout na Postgres (viz README)
DATABASE_URL="file:./dev.db"

# Veřejná URL aplikace (v produkci např. https://koncerty.example.com)
NEXTAUTH_URL="http://localhost:3000"
# `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me"

# --- E-mail (magic link přihlášení + notifikace o koncertech) ---
# Když EMAIL_SERVER není nastaveno, přihlašovací odkazy se ve vývoji vypisují do konzole.
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Koncerty <koncerty@example.com>"

# --- Zdroje koncertů (stačí nastavit ty, které chcete používat) ---
# Ticketmaster Discovery API (primární „ticketing" zdroj) – https://developer.ticketmaster.com
TICKETMASTER_API_KEY=""
# Bandsintown public API – https://artists.bandsintown.com/support/api-installation
BANDSINTOWN_APP_ID=""
# Google Programmable Search (pokrývá Google + facebook.com/events) – https://programmablesearchengine.google.com
GOOGLE_CSE_KEY=""
GOOGLE_CSE_ID=""

# --- Spotify (import top kapel) – https://developer.spotify.com/dashboard ---
# Redirect URI v dashboardu: {NEXTAUTH_URL}/api/spotify/callback
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- Cron ---
# Tajný token pro spouštění denního scanu přes /api/cron/scan
CRON_SECRET="change-me-too"
