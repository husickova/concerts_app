# --- Core ---
# SQLite for development; switch to Postgres in production (see README)
DATABASE_URL="file:./dev.db"

# Public URL of the app (in production e.g. https://gigalert.example.com)
NEXTAUTH_URL="http://localhost:3000"
# `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me"

# --- Email (magic-link sign-in + concert notifications) ---
# When EMAIL_SERVER is not set, sign-in links are printed to the console in development.
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Gig Alert <gigalert@example.com>"

# --- Concert sources (configure only the ones you want to use) ---
# Ticketmaster Discovery API (primary "ticketing" source) - https://developer.ticketmaster.com
TICKETMASTER_API_KEY=""
# Bandsintown public API - https://artists.bandsintown.com/support/api-installation
BANDSINTOWN_APP_ID=""
# Google Programmable Search (covers Google + facebook.com/events) - https://programmablesearchengine.google.com
GOOGLE_CSE_KEY=""
GOOGLE_CSE_ID=""

# --- Spotify (top artists import) - https://developer.spotify.com/dashboard ---
# Redirect URI in the dashboard: {NEXTAUTH_URL}/api/spotify/callback
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- Cron ---
# Secret token for triggering the daily scan via /api/cron/scan
CRON_SECRET="change-me-too"
